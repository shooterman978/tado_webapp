# Kopieren nach .env — niemals echte Secrets committen.

# API
API_PORT=3080
API_HOST=0.0.0.0
NODE_ENV=development

# Session / Auth (später). Min. 32 Zeichen zufällig.
APP_SESSION_SECRET=change-me-to-a-long-random-string

# Persistenz (Compose setzt DATABASE_URL automatisch)
# DATABASE_URL=postgres://heizplan:heizplan@db:5432/heizplan

# Bridge — Pairing-State (Volume), keine Secrets in Git
BRIDGE_DATA_DIR=/data/bridge
# Mock-Zonen nur solange unpaired. Nach Pairing liefert die API Live-Daten.
BRIDGE_USE_MOCK_ZONES=true

# Tado V3 Internet Bridge (HomeKit) — nur lokal in .env setzen
# TADO_BRIDGE_IP=192.168.x.x
# TADO_BRIDGE_PIN=XXX-XX-XXX
# TADO_BRIDGE_PORT=80

# Home Assistant Sync (später; Option A — bestehende VM)
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# CalDAV (später)
# ICAL_USER=
# ICAL_APP_PASSWORD=
