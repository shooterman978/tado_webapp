# Kopieren nach .env — niemals echte Secrets committen.

# API
API_PORT=3080
API_HOST=0.0.0.0
NODE_ENV=development

# Session / Auth (später). Min. 32 Zeichen zufällig.
APP_SESSION_SECRET=change-me-to-a-long-random-string

# Persistenz (Compose setzt DATABASE_URL automatisch)
# DATABASE_URL=postgres://heizplan:heizplan@db:5432/heizplan

# Bridge — Pairing-State (Volume), keine Secrets in Git
BRIDGE_DATA_DIR=/data/bridge
# Mock-Zonen nur solange unpaired. Nach Pairing liefert die API Live-Daten.
BRIDGE_USE_MOCK_ZONES=true

# Tado V3 Internet Bridge (HomeKit) — nur lokal in .env setzen
# TADO_BRIDGE_IP=192.168.x.x
# TADO_BRIDGE_PIN=XXX-XX-XXX
# TADO_BRIDGE_PORT=80

# Raumnamen + Smart Schedule (optional): einmaliger Cloud-Device-Code-Login via API
#   POST /api/cloud/auth/start  → Browser öffnen
#   POST /api/cloud/auth/poll   → Tokens + zone-metadata im Volume
#   GET/PUT /api/cloud/schedule/:roomId → Smart Schedule (sichtbar in Tado-App)
#   GET /api/cloud/quota → generisches Tagesbudget aller Cloud-HTTP-Calls
# Alternativ: room-map.json (Serial→Raumname) unter BRIDGE_DATA_DIR
# Keine Cloud-Credentials in .env nötig — Tokens liegen nur im Volume.
# Soft-Cap (Europe/Berlin-Tag); Default konservativ unter ~100 ohne Abo:
# CLOUD_DAILY_REQUEST_LIMIT=80

# Home Assistant Sync (später; Option A — bestehende VM)
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# CalDAV (später)
# ICAL_USER=
# ICAL_APP_PASSWORD=
