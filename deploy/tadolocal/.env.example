# Copy to .env and fill in. Never commit .env (see .gitignore).
#
# Bridge IP: router DHCP list / device name "tado" / bridge sticker / arp scan
# HomeKit PIN: sticker on the Tado Internet Bridge (format XXX-XX-XXX)

TADO_BRIDGE_IP=192.168.1.100
TADO_BRIDGE_PIN=123-45-678

# API listen port (default 4407). With network_mode: host this is the host/LXC port.
TADO_PORT=4407

# Optional: Bearer tokens for REST API (space-separated). Leave empty for LAN-open spike.
# Web UI (/) stays reachable without auth even when keys are set.
# TADO_API_KEYS=spike-test-key

# Optional standalone HomeKit accessories (comma-separated), not needed for V3 Bridge-only:
# TADO_ACCESSORY_IP=
# TADO_ACCESSORY_PIN=
